rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
//  MM2 Values — Firestore security rules
//
//  ⚠️ WHAT IS LIVE RIGHT NOW (ruleset 172c3c69-3d97-44a0-8ca5-c6c6e231ead8,
//     last changed 2026-03-05):
//
//        match /{document=**} {
//          allow read, write: if request.time < timestamp.date(2029, 3, 5);
//        }
//
//     That is the console's "test mode" default with the expiry pushed out.
//     Anyone who reads the project ID out of the app bundle can read, rewrite
//     or delete EVERY document — trades, reviews, posts, profiles, scores —
//     with no account and no token. See PLAN_2026-09.md S1.
//
//  STAGE 1 (this file). Public read stays exactly as it is; every write now
//  requires a signed-in user. This cannot break a legitimate flow — every
//  write path in the app already runs behind Firebase Auth — and it removes
//  anonymous vandalism, which is the actual emergency.
//
//  STAGE 2 is drafted at the bottom: per-collection owner checks. It needs
//  testing against the real client before it goes anywhere near production,
//  because a wrong ownership field fails silently and looks like a bug in
//  the app rather than a rules problem.
//
//  Deploy stage 1:
//    firebase deploy --only firestore:rules --project mm2vlaues-ed80c
//  Roll back: Firebase console → Firestore → Rules → History → the
//  2026-03-05 ruleset → Restore.
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Staff, as the STAFF expression in database.rules.json defines it.
    // Firestore rules cannot read RTDB, so the role flags arrive as a `staff`
    // custom claim that functions/syncStaffClaims.js keeps in step; the
    // founder emails are checked here directly, as everywhere else.
    function isStaff() {
      return signedIn() && (
        request.auth.token.staff == true
        || (request.auth.token.email_verified == true
            && request.auth.token.email in ['thesolanalabs@gmail.com', 'sohailnasir74business@gmail.com', 'sohailnasir74@gmail.com'])
      );
    }

    // Reads stay open: the app browses trades, posts and leaderboards before
    // the user signs in, and locking reads here would blank those screens for
    // every existing build in the field.
    //
    // Writes require an account. Nothing in the app writes while signed out.
    //
    // 2026-09-27 (round 2): reads open on every collection EXCEPT
    // mod_actions. Rules only ever add access — a second match cannot narrow
    // what this one allows — so the catch-all itself has to leave mod_actions
    // out. `/{collection}/{document=**}` matches every document the old
    // `/{document=**}` did (all documents live in a collection); the one shape
    // it would not cover is a collection-group query, and no client makes one.
    match /{collection}/{document=**} {
      allow read: if collection != 'mod_actions';
      allow write: if signedIn();
    }

    // Moderation audit log (Code/Helper/modLog.js). Every row carries the
    // target's email, and its only reader is the Admin Dashboard — Mod Log
    // tab and user sheet — which only admins, moderators and Junior Mods can
    // open. Writes stay as they were (the catch-all above): build 1.4.6
    // logs report auto-bans from the REPORTER's device.
    //
    // Deploy only after syncStaffClaims has run once AND an hour has passed,
    // so every staff member's ID token has refreshed with the claim.
    // Otherwise the Mod Log shows "failed" for them until it does.
    match /mod_actions/{actionId} {
      allow read: if isStaff();
    }
  }
}

// ═══════════════════════════════════════════════════════════════════════
//  STAGE 2 — DRAFT, NOT ACTIVE.
//
//  Replace the catch-all above with per-collection rules once each one has
//  been exercised in the Rules Playground against a real document. The
//  ownership field differs per collection, and getting it wrong denies a
//  write that the app treats as a silent failure.
//
//  Collections in use, with the field that identifies the owner:
//
//    trades_new             userId
//    reviews                fromUserId (a review) / doc id == uid (profile doc)
//    designPosts            userId          + subcollection comments (userId)
//    statuses               userId
//    user_profiles          doc id == uid
//    user_ratings_summary   doc id == uid   ← written ABOUT a user BY a rater,
//                                             so an owner-only rule breaks it
//    game_stats, games      doc id == uid
//    cosmetics_inventory    doc id == uid
//    following              followerId
//    notifications          written FOR another user (toUid) — owner-only
//                                             rules break trade pings
//    group_invitations      invitedBy
//    group_join_requests    requesterId
//    groups                 createdBy, plus member writes
//    streaks                user1 / user2
//    polls                  admin-only write, public read
//    mod_actions            append-only moderation audit log (Code/Helper/modLog.js):
//                           create if signed-in staff, NO update, NO delete —
//                           a moderator must not be able to erase their own row.
//                           Under the stage-1 catch-all this is a convention only.
//                           READ is already staff-only (round 2, above). Note
//                           build 1.4.6 creates rows from ordinary users'
//                           devices (report auto-ban), so "create if staff"
//                           breaks that logging until 1.4.6 is gone.
//    mystery_levels         read-only from the client
//    leaderboard,
//    game_leaderboard_cache Cloud Function writes only
//
//  Two of those (user_ratings_summary, notifications) are deliberately
//  written by someone other than the subject. Any "users can only write
//  their own documents" rule breaks ratings and trade notifications, which
//  is exactly the kind of regression that is hard to spot in testing and
//  obvious to users.
// ═══════════════════════════════════════════════════════════════════════
