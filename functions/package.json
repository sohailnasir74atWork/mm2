{
  "name": "functions",
  "description": "Cloud Functions for MM2 Values",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:birthdays": "firebase emulators:exec --config ../firebase.test.json --project demo-mm2 --only database,firestore,auth 'node --test test/birthdays.test.js'"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "private": true,
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0"
  }
}
