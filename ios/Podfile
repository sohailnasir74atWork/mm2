# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'bloxfruitevalues' do
  config = use_native_modules!
  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true
  # Pin the Firebase iOS SDK ahead of React Native Firebase's default.
  # RNFB resolves 12.10.0 here; the fix we need landed in 12.19.0.
  #
  # Firebase iOS 12.19.0 (#16498): "Fixed an issue on iOS 15+ where users were
  # randomly logged out during prewarming while the device was locked."
  # iOS prewarms the app process before the user taps the icon, often while the
  # device is locked; the keychain is then unreadable, Auth cannot restore the
  # persisted session, and the user appears signed out.
  #
  # Diagnosed in adoptme-jan7, where it was measurable: Crashlytics 98edaf64,
  # 256 events / 100 users a week. This app has no equivalent auth telemetry, so
  # the impact here is unmeasured - but it runs the same SDK on the same minimum
  # iOS version, so it has the same bug. See HANDOFF_2026-09-21.md in
  # adoptme-jan7 for the full write-up.
  #
  # Use 12.19.0 EXACTLY. 12.19.1 and 12.19.2 exist on GitHub but were never
  # published to the CocoaPods trunk, and CocoaPods misreports that as a
  # "higher minimum deployment target" error.
  $FirebaseSDKVersion = '12.19.0'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end
  end
end
